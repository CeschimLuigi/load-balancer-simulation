{
  "name": "cluster-api",
  "version": "1.0.0",
  "description": "servidor api para testar cluster de balanceador de carga",
  "main": "build/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "clean": "rm -rf build",
    "build": "npm run clean && tsc",
