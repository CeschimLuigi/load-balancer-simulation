{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023"],
        "paths": {
            "@/*":["./src/*"]
        },
        "module": "esnext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
    },
    
    
    "exclude": [
        "node_modules"
    ]
}