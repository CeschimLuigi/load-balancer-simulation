{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023"],
        "paths": {
            "@/*":["./src/*"]
        },
        "module": "nodenext",
        "rootDir": "./src",
        "outDir": "./build",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
    },
    
    
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}